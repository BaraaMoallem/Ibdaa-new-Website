# Set to the public, canonical origin when the production domain is confirmed.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Exact public HTTPS origin, without a path (required in production).
CASE_ALLOWED_ORIGIN=https://your-domain.example
# Published Apps Script web-app URL; /exec, never /dev.
GOOGLE_CASE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Generate at least 32 random bytes; use the SAME value as SHARED_SECRET in Script Properties.
GOOGLE_CASE_SHARED_SECRET=REPLACE_WITH_A_CRYPTOGRAPHIC_RANDOM_SECRET
